# CAFirm environment configuration
# Copy this file to .env and adjust values for your machine.

FLASK_CONFIG=development
FLASK_DEBUG=1

# Security
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL connection (local machine)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/cafarm_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/cafarm_test

# Cookies / sessions
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=8

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10
MAX_FILE_SIZE_MB=5

# Visitor tracking tokens
TRACKING_TOKEN_TTL_DAYS=90

# Local rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
PUBLIC_SUBMIT_RATE_LIMIT=10
PUBLIC_SUBMIT_RATE_WINDOW=3600
